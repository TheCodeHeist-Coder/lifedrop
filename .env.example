# Copy to .env.local. Only DATABASE_URL is required to run.

# Local YugabyteDB (see README), or YugabyteDB Aeon:
# postgresql://admin:PASSWORD@HOST:5433/yugabyte?sslmode=verify-full&sslrootcert=./root.crt
DATABASE_URL=postgresql://yugabyte@127.0.0.1:5433/yugabyte

# Turns on /demo, which can reply as any donor. Never set this on a real deployment.
DEMO_MODE=true

# Seconds to wait for replies before widening the search. Use about 600 for real use.
WAVE_TIMEOUT_SECONDS=45
DONORS_PER_WAVE=5

# Public address of this app, with no trailing slash. Needed for Twilio webhooks.
PUBLIC_URL=

# Leave these empty and WhatsApp is simulated in /demo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NEXT_PUBLIC_WHATSAPP_NUMBER=14155238886
# The word after "join" on Twilio's sandbox page, e.g. happy-tiger
NEXT_PUBLIC_TWILIO_SANDBOX_CODE=

# Leave empty and message parsing uses the built-in rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
